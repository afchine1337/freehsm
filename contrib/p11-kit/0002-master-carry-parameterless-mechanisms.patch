+	case CKM_SHA3_256_KEY_GEN:
+	case CKM_SHA3_384:
+	case CKM_SHA3_384_HMAC:
+	case CKM_SHA3_384_KEY_GEN:
+	case CKM_SHA3_512:
+	case CKM_SHA3_512_HMAC:
+	case CKM_SHA3_512_KEY_GEN:
